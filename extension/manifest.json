{
  "manifest_version": 3,
  "name": "NFSU2.xyz Discord Presence",
  "version": "1.0.0",
  "description": "Shows Discord Rich Presence while an nfsu2.xyz tab is open in Brave or Chrome.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging"],
  "host_permissions": ["https://nfsu2.xyz/*"],
  "background": {
    "service_worker": "service-worker.js"
  }
}
